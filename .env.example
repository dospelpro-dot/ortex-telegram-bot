# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Telegram (required to run the bot) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # optional: chat/channel id for auto-scan pushes
AUTOSCAN_MINUTES=0           # 0 = off; e.g. 30 = auto-scan every 30 min

# --- ORTEX (squeeze-fuel signal) ---
ORTEX_API_KEY=
ORTEX_BASE_URL=https://api.ortex.com

# --- Market data ---
# If POLYGON_API_KEY is set it is used; otherwise yfinance (no key) is the fallback.
POLYGON_API_KEY=

# --- Social velocity (primary signal) ---
# StockTwits needs no key. X and Reddit are optional but add breadth.
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ortex-attention-scanner/0.1

# --- Universe / tuning (optional; defaults live in config.py) ---
WATCHLIST=                   # comma-separated tickers to always include, e.g. GME,AMC
MISSION_N_NAMES=3
MISSION_TARGET_MOVE_PCT=15
MISSION_HORIZON_MIN=1
MISSION_HORIZON_MAX=3

# Scoring weights (auto-normalised)
W_SOCIAL=0.35
W_SPARK=0.15                 # "first spark": attention accelerating before price moves
W_SQUEEZE=0.25
W_EARLY=0.15
W_RETAIL=0.10
SPARK_THRESHOLD=0.55         # spark sub-score above this earns the 🔥 flag
